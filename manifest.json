{
  "manifest_version": 3,
  "name": "Talabat Script Library",
  "version": "1.0",
  "description": "Talabat Customer Service Script Library Extension",
  "permissions": [
    "sidePanel",
    "storage",
    "clipboardWrite"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open Talabat Script Panel"
  }
}
